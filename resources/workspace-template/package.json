{
  "name": "{{workspaceSlug}}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "guard:path": "node -e \"if(/[^\\x00-\\x7F]/.test(process.cwd())){console.error('[vanilla] Non-ASCII path: move this folder to an ASCII-only path and run again (e.g. C:/class/my-work).');process.exit(1)}\"",
    "dev": "pnpm guard:path && vite",
    "play": "pnpm guard:path && vite --open play.html",
    "preview": "pnpm guard:path && vite preview --open play.html",
    "build": "pnpm guard:path && vite build",
    "check:scene": "pnpm guard:path && node scripts/check-scene.mjs",
    "vanilla": "pnpm guard:path && node scripts/vanilla-agent.mjs",
    "dist": "node scripts/pack-workspace.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@vanilla/runtime": "link:./vanilla/runtime",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
