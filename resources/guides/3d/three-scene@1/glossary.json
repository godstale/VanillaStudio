      "definition": {
        "ko": "원이 열리며 다음 장면이 보입니다.",
        "en": "A circle opens onto the next scene."
      },
      "implementationHint": "animate circle clip-path radius from 0.",
      "tags": []
    },
    {
      "category": "transition",
      "id": "shape-transition",
      "label": {
        "ko": "도형 전환",
