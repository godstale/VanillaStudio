    {
      "category": "structure",
      "id": "multi-shot",
      "label": {
        "ko": "멀티 샷",
        "en": "Multi-shot"
      },
      "definition": {
        "ko": "여러 장면을 전환으로 이어 붙입니다.",
        "en": "Several scenes joined by transitions."
