{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vanilla Studio",
  "version": "0.1.0",
  "identifier": "dev.vanilla.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14200",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Vanilla Studio",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/project-template": "resources/project-template",
      "../resources/runtime": "resources/runtime",
      "../resources/workers": "resources/workers",
      "../resources/palettes": "resources/palettes",
      "../resources/templates": "resources/templates",
      "../resources/skills": "resources/skills"
    },
    "shortDescription": "Brief to product pipeline studio",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
