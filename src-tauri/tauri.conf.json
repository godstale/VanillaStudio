{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vanilla Studio",
  "version": "0.1.0",
  "identifier": "dev.vanilla.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14200",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Vanilla Studio",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; style-src 'self' 'unsafe-inline' http://localhost:*; img-src 'self' asset: https://asset.localhost https://media.skillry.dev blob: data: http://localhost:*; font-src 'self' data: http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; frame-src http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/project-template": "resources/project-template",
      "../resources/workspace-template": "resources/workspace-template",
      "../resources/runtime": "resources/runtime",
      "../resources/workers": "resources/workers",
      "../resources/palettes": "resources/palettes",
      "../resources/skills": "resources/skills",
      "../resources/guides": "resources/guides",
      "../resources/opus": "resources/opus"
    },
    "shortDescription": "Brief to product pipeline studio",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
